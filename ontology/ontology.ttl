#################################################################
#    Object Properties
#################################################################

###  https://climatepub4kg.github.io/ontology#AFFECTED_REGION
:AFFECTED_REGION rdf:type owl:ObjectProperty ;
                 rdfs:domain :Natural_Hazard ;
                 rdfs:range :City ,
                            :Continent ,
                            :Country ,
                            :Country_Subdivision ,
                            :No_Country_Region ;
                 rdfs:comment "Relates a natural hazard to a geographic region it affected."@en ;
                 rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                 rdfs:label "AFFECTED_REGION" ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Relates a natural hazard to a geographic region it affected."@en .


###  https://climatepub4kg.github.io/ontology#APPLIES_TO_REALM
:APPLIES_TO_REALM rdf:type owl:ObjectProperty ;
                  rdfs:domain :Experiment ,
                              :Source ,
                              :SourceComponent ;
                  rdfs:range :Realm ;
                  rdfs:comment "Relates a climate model, model component or experiment to an Earth system realm it addresses."@en ;
                  rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                  rdfs:label "APPLIES_TO_REALM" ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relates a climate model, model component or experiment to an Earth system realm it addresses."@en .


###  https://climatepub4kg.github.io/ontology#ASSOCIATED_WITH_MEMBER
:ASSOCIATED_WITH_MEMBER rdf:type owl:ObjectProperty ;
                        rdfs:domain :Source ;
                        rdfs:range :Member ;
                        rdfs:comment "Relates a climate model to a variant label (member) under which its output was produced."@en ;
                        rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                        rdfs:label "ASSOCIATED_WITH_MEMBER" ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Relates a climate model to a variant label (member) under which its output was produced."@en .


###  https://climatepub4kg.github.io/ontology#BELONGS_TO_MIP_ERA
:BELONGS_TO_MIP_ERA rdf:type owl:ObjectProperty ;
                    rdfs:domain :Source ;
                    rdfs:range :MIPEra ;
                    rdfs:comment "Relates a climate model or experiment family to the MIP generation it belongs to."@en ;
                    rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                    rdfs:label "BELONGS_TO_MIP_ERA" ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Relates a climate model or experiment family to the MIP generation it belongs to."@en .


###  https://climatepub4kg.github.io/ontology#CITED_BY
:CITED_BY rdf:type owl:ObjectProperty ;
          rdfs:domain :Paper ;
          rdfs:range :Paper ;
          rdfs:comment "Relates a publication to another publication that cites it, as recorded in the bibliographic reference data."@en ;
          rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
          rdfs:label "CITED_BY" ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates a publication to another publication that cites it, as recorded in the bibliographic reference data."@en .


###  https://climatepub4kg.github.io/ontology#COVERS_DOMAIN
:COVERS_DOMAIN rdf:type owl:ObjectProperty ;
               rdfs:domain :Project ,
                           :RCM ;
               rdfs:range :Domain ;
               rdfs:comment "Relates a project or regional climate model to the spatial domain it is run over."@en ;
               rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
               rdfs:label "COVERS_DOMAIN" ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates a project or regional climate model to the spatial domain it is run over."@en .


###  https://climatepub4kg.github.io/ontology#COVERS_REGION
:COVERS_REGION rdf:type owl:ObjectProperty ;
               rdfs:domain :RCM ;
               rdfs:range :City ,
                          :Continent ,
                          :Country ,
                          :Country_Subdivision ,
                          :No_Country_Region ;
               rdfs:comment "Relates a regional climate model to a geographic region that falls within its domain."@en ;
               rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
               rdfs:label "COVERS_REGION" ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates a regional climate model to a geographic region that falls within its domain."@en .


###  https://climatepub4kg.github.io/ontology#DRIVEN_BY_SOURCE
:DRIVEN_BY_SOURCE rdf:type owl:ObjectProperty ;
                  rdfs:domain :RCM ;
                  rdfs:range :Source ;
                  rdfs:comment "Relates a regional climate model to the global model that supplies its lateral boundary conditions."@en ;
                  rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                  rdfs:label "DRIVEN_BY_SOURCE" ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relates a regional climate model to the global model that supplies its lateral boundary conditions."@en .


###  https://climatepub4kg.github.io/ontology#FOCUSES_ON_REALM
:FOCUSES_ON_REALM rdf:type owl:ObjectProperty ;
                  rdfs:domain :Activity ;
                  rdfs:range :Realm ;
                  rdfs:comment "Relates a MIP activity to the Earth system realm its experiments focus on."@en ;
                  rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                  rdfs:label "FOCUSES_ON_REALM" ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relates a MIP activity to the Earth system realm its experiments focus on."@en .


###  https://climatepub4kg.github.io/ontology#GENERATED_BY_ACTIVITY
:GENERATED_BY_ACTIVITY rdf:type owl:ObjectProperty ;
                       rdfs:domain :Source ;
                       rdfs:range :Activity ;
                       rdfs:comment "Relates a climate model to the MIP activity whose experiments produced its output."@en ;
                       rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                       rdfs:label "GENERATED_BY_ACTIVITY" ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Relates a climate model to the MIP activity whose experiments produced its output."@en .


###  https://climatepub4kg.github.io/ontology#HAS_CLIMATE_ZONE
:HAS_CLIMATE_ZONE rdf:type owl:ObjectProperty ;
                  rdfs:domain :No_Country_Region ;
                  rdfs:range :ClimateZone ;
                  rdfs:comment "Relates a geographic region to a climate zone it falls in."@en ;
                  rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                  rdfs:label "HAS_CLIMATE_ZONE" ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relates a geographic region to a climate zone it falls in."@en .


###  https://climatepub4kg.github.io/ontology#HAS_METRIC
:HAS_METRIC rdf:type owl:ObjectProperty ;
            rdfs:domain :Source ;
            rdfs:range :Metric ;
            rdfs:comment "Relates a climate model to a characteristic quantity reported for it, such as its climate sensitivity."@en ;
            rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
            rdfs:label "HAS_METRIC" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a climate model to a characteristic quantity reported for it, such as its climate sensitivity."@en .


###  https://climatepub4kg.github.io/ontology#HAS_PHYSICAL_FEATURE
:HAS_PHYSICAL_FEATURE rdf:type owl:ObjectProperty ;
                      rdfs:domain :Source ;
                      rdfs:range :PhysicalFeature ;
                      rdfs:comment "Relates a climate model to a physical process or property it represents."@en ;
                      rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                      rdfs:label "HAS_PHYSICAL_FEATURE" ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Relates a climate model to a physical process or property it represents."@en .


###  https://climatepub4kg.github.io/ontology#HAS_SIMULATION_TYPE
:HAS_SIMULATION_TYPE rdf:type owl:ObjectProperty ;
                     rdfs:domain :Source ;
                     rdfs:range :SimulationType ;
                     rdfs:comment "Relates a climate model to a style of simulation it is run in."@en ;
                     rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                     rdfs:label "HAS_SIMULATION_TYPE" ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Relates a climate model to a style of simulation it is run in."@en .


###  https://climatepub4kg.github.io/ontology#HAS_SOURCE_COMPONENT
:HAS_SOURCE_COMPONENT rdf:type owl:ObjectProperty ;
                      rdfs:domain :Source ,
                                  :SourceComponent ;
                      rdfs:range :SourceComponent ;
                      rdfs:comment "Relates a climate model, or one of its components, to a constituent submodel."@en ;
                      rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                      rdfs:label "HAS_SOURCE_COMPONENT" ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Relates a climate model, or one of its components, to a constituent submodel."@en .


###  https://climatepub4kg.github.io/ontology#HAS_SPATIAL_RESOLUTION
:HAS_SPATIAL_RESOLUTION rdf:type owl:ObjectProperty ;
                        rdfs:domain :Experiment ,
                                    :Source ,
                                    :Variable ;
                        rdfs:range :Resolution ;
                        rdfs:comment "Relates a climate model, regional model, experiment or variable to its nominal spatial resolution."@en ;
                        rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                        rdfs:label "HAS_SPATIAL_RESOLUTION" ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Relates a climate model, regional model, experiment or variable to its nominal spatial resolution."@en .


###  https://climatepub4kg.github.io/ontology#HAS_SUBSEQUENT_VERSION
:HAS_SUBSEQUENT_VERSION rdf:type owl:ObjectProperty ;
                        rdfs:domain :Source ,
                                    :SourceComponent ;
                        rdfs:range :Source ,
                                   :SourceComponent ;
                        rdfs:comment "Relates a climate model or model component to a later version of itself."@en ;
                        rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                        rdfs:label "HAS_SUBSEQUENT_VERSION" ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Relates a climate model or model component to a later version of itself."@en .


###  https://climatepub4kg.github.io/ontology#HAS_SUB_EXPERIMENT
:HAS_SUB_EXPERIMENT rdf:type owl:ObjectProperty ;
                    rdfs:domain :Experiment ;
                    rdfs:range :SubExperiment ;
                    rdfs:comment "Relates an experiment to one of its sub-experiments."@en ;
                    rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                    rdfs:label "HAS_SUB_EXPERIMENT" ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Relates an experiment to one of its sub-experiments."@en .


###  https://climatepub4kg.github.io/ontology#IMPACTED_REGION
:IMPACTED_REGION rdf:type owl:ObjectProperty ;
                 rdfs:domain :Weather_Event ;
                 rdfs:range :City ,
                            :Continent ,
                            :Country ,
                            :Country_Subdivision ,
                            :No_Country_Region ;
                 rdfs:comment "Relates a weather or climate event to a geographic region it impacted."@en ;
                 rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                 rdfs:label "IMPACTED_REGION" ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Relates a weather or climate event to a geographic region it impacted."@en .


###  https://climatepub4kg.github.io/ontology#INCLUDES_ENSEMBLE_MEMBER
:INCLUDES_ENSEMBLE_MEMBER rdf:type owl:ObjectProperty ;
                          rdfs:domain :Experiment ;
                          rdfs:range :Ensemble ;
                          rdfs:comment "Relates an experiment to an ensemble of simulations carried out for it."@en ;
                          rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                          rdfs:label "INCLUDES_ENSEMBLE_MEMBER" ;
                          <http://www.w3.org/2004/02/skos/core#definition> "Relates an experiment to an ensemble of simulations carried out for it."@en .


###  https://climatepub4kg.github.io/ontology#INCLUDES_EXPERIMENT
:INCLUDES_EXPERIMENT rdf:type owl:ObjectProperty ;
                     rdfs:domain :ExperimentFamily ;
                     rdfs:range :Experiment ;
                     rdfs:comment "Relates an experiment family to one of its member experiments."@en ;
                     rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                     rdfs:label "INCLUDES_EXPERIMENT" ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Relates an experiment family to one of its member experiments."@en .


###  https://climatepub4kg.github.io/ontology#INFLUENCES_REGION
:INFLUENCES_REGION rdf:type owl:ObjectProperty ;
                   rdfs:domain :Teleconnection ;
                   rdfs:range :City ,
                              :Continent ,
                              :Country ,
                              :Country_Subdivision ,
                              :No_Country_Region ;
                   rdfs:comment "Relates a teleconnection pattern to a geographic region whose climate it influences."@en ;
                   rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                   rdfs:label "INFLUENCES_REGION" ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Relates a teleconnection pattern to a geographic region whose climate it influences."@en .


###  https://climatepub4kg.github.io/ontology#INHERITED_FROM
:INHERITED_FROM rdf:type owl:ObjectProperty ;
                rdfs:domain :Source ;
                rdfs:range :Source ;
                rdfs:comment "Relates a climate model to an earlier model it was derived from."@en ;
                rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                rdfs:label "INHERITED_FROM" ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates a climate model to an earlier model it was derived from."@en .


###  https://climatepub4kg.github.io/ontology#IN_CONTINENT
:IN_CONTINENT rdf:type owl:ObjectProperty ;
              rdfs:domain :Country ;
              rdfs:range :Continent ;
              rdfs:comment "Relates a country to the continent it lies in."@en ;
              rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
              rdfs:label "IN_CONTINENT" ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates a country to the continent it lies in."@en .


###  https://climatepub4kg.github.io/ontology#IN_COUNTRY
:IN_COUNTRY rdf:type owl:ObjectProperty ;
            rdfs:domain :City ,
                        :Country_Subdivision ;
            rdfs:range :Country ;
            rdfs:comment "Relates a city or administrative subdivision to the country that contains it."@en ;
            rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
            rdfs:label "IN_COUNTRY" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a city or administrative subdivision to the country that contains it."@en .


###  https://climatepub4kg.github.io/ontology#IS_OF_TYPE
:IS_OF_TYPE rdf:type owl:ObjectProperty ;
            rdfs:domain :Natural_Hazard ,
                        :Source ;
            rdfs:range :NaturalHazardType ,
                       :SourceType ;
            rdfs:comment "Relates an entity to its category: a climate model to its source type, or a natural hazard to its hazard type."@en ;
            rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
            rdfs:label "IS_OF_TYPE" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an entity to its category: a climate model to its source type, or a natural hazard to its hazard type."@en .


###  https://climatepub4kg.github.io/ontology#MEASURES_VARIABLE
:MEASURES_VARIABLE rdf:type owl:ObjectProperty ;
                   rdfs:domain :Instrument ;
                   rdfs:range :Variable ;
                   rdfs:comment "Relates an observing instrument to a geophysical variable it measures."@en ;
                   rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                   rdfs:label "MEASURES_VARIABLE" ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Relates an observing instrument to a geophysical variable it measures."@en .


###  https://climatepub4kg.github.io/ontology#METHOD_EXPERIMENTS_ON_OBSERVATIONAL_DATASET
:METHOD_EXPERIMENTS_ON_OBSERVATIONAL_DATASET rdf:type owl:ObjectProperty ;
                                             rdfs:domain :Method ;
                                             rdfs:range :ObservationalDataset ;
                                             rdfs:comment "Relates a method to an observational or reanalysis dataset it is applied to."@en ;
                                             rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                                             rdfs:label "METHOD_EXPERIMENTS_ON_OBSERVATIONAL_DATASET" ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "Relates a method to an observational or reanalysis dataset it is applied to."@en .


###  https://climatepub4kg.github.io/ontology#METHOD_HAS_INNOVATION
:METHOD_HAS_INNOVATION rdf:type owl:ObjectProperty ;
                       rdfs:domain :Method ;
                       rdfs:range :Innovation ;
                       rdfs:comment "Relates a method to a novel contribution it introduces."@en ;
                       rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                       rdfs:label "METHOD_HAS_INNOVATION" ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Relates a method to a novel contribution it introduces."@en .


###  https://climatepub4kg.github.io/ontology#METHOD_HAS_RESULT
:METHOD_HAS_RESULT rdf:type owl:ObjectProperty ;
                   rdfs:domain :Method ;
                   rdfs:range :Result ;
                   rdfs:comment "Relates a method to a finding obtained with it."@en ;
                   rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                   rdfs:label "METHOD_HAS_RESULT" ;
