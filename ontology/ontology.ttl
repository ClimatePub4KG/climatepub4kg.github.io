:type rdf:type owl:DatatypeProperty ;
      rdfs:domain :Venue ;
      rdfs:range xsd:string ;
      rdfs:comment "Kind of publication venue, such as journal, conference, book series or repository."@en ;
      rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
      rdfs:label "type" ;
      <http://www.w3.org/2004/02/skos/core#definition> "Kind of publication venue, such as journal, conference, book series or repository."@en .


###  https://climatepub4kg.github.io/ontology#uuid
:uuid rdf:type owl:DatatypeProperty ;
      rdfs:domain :Activity ,
                  :Author ,
                  :City ,
                  :ClimateZone ,
                  :Continent ,
                  :Country ,
                  :Country_Subdivision ,
                  :Domain ,
                  :Ensemble ,
                  :EvaluationMetric ,
                  :Experiment ,
                  :ExperimentFamily ,
                  :Field ,
                  :Forcing ,
                  :Frequency ,
                  :GridLabel ,
                  :Innovation ,
                  :Institute ,
                  :Instrument ,
                  :Keyword ,
                  :MIPEra ,
                  :Member ,
                  :Method ,
                  :Metric ,
                  :NaturalHazardType ,
                  :Natural_Hazard ,
                  :No_Country_Region ,
                  :ObservationalDataset ,
                  :Ocean_Circulation ,
                  :Paper ,
                  :PhysicalFeature ,
                  :PhysicalScheme ,
                  :Platform ,
                  :Problem ,
                  :Project ,
                  :RCM ,
                  :Realm ,
                  :Resolution ,
                  :Result ,
                  :SimulationType ,
                  :Source ,
                  :SourceComponent ,
                  :SourceType ,
                  :SubExperiment ,
                  :Task ,
                  :Teleconnection ,
                  :Variable ,
                  :Venue ,
                  :Weather_Event ;
      rdfs:range xsd:string ;
      rdfs:comment "Stable internal identifier of the entity within the knowledge graph."@en ;
      rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
      rdfs:label "uuid" ;
      <http://www.w3.org/2004/02/skos/core#definition> "Stable internal identifier of the entity within the knowledge graph."@en .


###  https://climatepub4kg.github.io/ontology#variable_long_name
:variable_long_name rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Variable ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Long, descriptive name of a variable."@en ;
                    rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                    rdfs:label "variable_long_name" ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Long, descriptive name of a variable."@en .


###  https://climatepub4kg.github.io/ontology#variable_units
:variable_units rdf:type owl:DatatypeProperty ;
                rdfs:domain :Variable ;
                rdfs:range xsd:string ;
                rdfs:comment "Physical units in which a variable is reported."@en ;
                rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                rdfs:label "variable_units" ;
                <http://www.w3.org/2004/02/skos/core#definition> "Physical units in which a variable is reported."@en .


###  https://climatepub4kg.github.io/ontology#west
:west rdf:type owl:DatatypeProperty ;
      rdfs:domain :Country ,
                  :Country_Subdivision ,
                  :No_Country_Region ;
      rdfs:range xsd:string ;
      rdfs:comment "Western edge of the entity's bounding box, in decimal degrees."@en ;
      rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
      rdfs:label "west" ;
      <http://www.w3.org/2004/02/skos/core#definition> "Western edge of the entity's bounding box, in decimal degrees."@en .


#################################################################
#    Classes
#################################################################

###  https://climatepub4kg.github.io/ontology#Activity
:Activity rdf:type owl:Class ;
          rdfs:comment "A Model Intercomparison Project (MIP) activity within a MIP era, such as CMIP, ScenarioMIP or DAMIP, that defines and coordinates a related set of climate model experiments. Corresponds to the ESGF activity_id facet."@en ;
          rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
          rdfs:label "Activity" ;
          <http://www.w3.org/2004/02/skos/core#definition> "A Model Intercomparison Project (MIP) activity within a MIP era, such as CMIP, ScenarioMIP or DAMIP, that defines and coordinates a related set of climate model experiments. Corresponds to the ESGF activity_id facet."@en .


###  https://climatepub4kg.github.io/ontology#Author
:Author rdf:type owl:Class ;
        rdfs:comment "A person credited as an author of a publication."@en ;
        rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
        rdfs:label "Author" ;
        <http://www.w3.org/2004/02/skos/core#definition> "A person credited as an author of a publication."@en .


###  https://climatepub4kg.github.io/ontology#City
:City rdf:type owl:Class ;
      rdfs:comment "A populated place, such as a city, town or village, as identified in the GeoNames gazetteer."@en ;
      rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
      rdfs:label "City" ;
      <http://www.w3.org/2004/02/skos/core#definition> "A populated place, such as a city, town or village, as identified in the GeoNames gazetteer."@en .


###  https://climatepub4kg.github.io/ontology#ClimateZone
:ClimateZone rdf:type owl:Class ;
             rdfs:comment "A broad climate zone (tropical, arid, temperate, cold or polar) following the top level of the Koppen-Geiger climate classification."@en ;
             rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
             rdfs:label "ClimateZone" ;
             <http://www.w3.org/2004/02/skos/core#definition> "A broad climate zone (tropical, arid, temperate, cold or polar) following the top level of the Koppen-Geiger climate classification."@en .


###  https://climatepub4kg.github.io/ontology#Continent
:Continent rdf:type owl:Class ;
           rdfs:comment "A continent, as identified in the GeoNames gazetteer."@en ;
           rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
           rdfs:label "Continent" ;
           <http://www.w3.org/2004/02/skos/core#definition> "A continent, as identified in the GeoNames gazetteer."@en .


###  https://climatepub4kg.github.io/ontology#Country
:Country rdf:type owl:Class ;
         rdfs:comment "A country or dependent territory, as identified in the GeoNames gazetteer, together with its ISO codes and country-level attributes."@en ;
         rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
         rdfs:label "Country" ;
         <http://www.w3.org/2004/02/skos/core#definition> "A country or dependent territory, as identified in the GeoNames gazetteer, together with its ISO codes and country-level attributes."@en .


###  https://climatepub4kg.github.io/ontology#Country_Subdivision
:Country_Subdivision rdf:type owl:Class ;
                     rdfs:comment "A first-level administrative subdivision of a country, such as a state, province, region or canton, as identified in the GeoNames gazetteer."@en ;
                     rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                     rdfs:label "Country_Subdivision" ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A first-level administrative subdivision of a country, such as a state, province, region or canton, as identified in the GeoNames gazetteer."@en .


###  https://climatepub4kg.github.io/ontology#Domain
:Domain rdf:type owl:Class ;
        rdfs:comment "A named spatial domain over which a project or regional climate model is run, such as the CORDEX domains EUR-11 or AFR-44."@en ;
        rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
        rdfs:label "Domain" ;
        <http://www.w3.org/2004/02/skos/core#definition> "A named spatial domain over which a project or regional climate model is run, such as the CORDEX domains EUR-11 or AFR-44."@en .


###  https://climatepub4kg.github.io/ontology#Ensemble
:Ensemble rdf:type owl:Class ;
          rdfs:comment "A set of simulations of the same experiment that differ only in their realisation, initialisation, physics or forcing settings, used to sample uncertainty."@en ;
          rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
          rdfs:label "Ensemble" ;
          <http://www.w3.org/2004/02/skos/core#definition> "A set of simulations of the same experiment that differ only in their realisation, initialisation, physics or forcing settings, used to sample uncertainty."@en .


###  https://climatepub4kg.github.io/ontology#EvaluationMetric
:EvaluationMetric rdf:type owl:Class ;
                  rdfs:comment "A measure used to evaluate a model, method, task or result, such as root-mean-square error, bias, correlation or skill score."@en ;
                  rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                  rdfs:label "EvaluationMetric" ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A measure used to evaluate a model, method, task or result, such as root-mean-square error, bias, correlation or skill score."@en .


###  https://climatepub4kg.github.io/ontology#Experiment
:Experiment rdf:type owl:Class ;
            rdfs:comment "A prescribed simulation protocol that models are run under, such as historical, piControl or ssp585. Corresponds to the ESGF experiment_id facet."@en ;
            rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
            rdfs:label "Experiment" ;
            <http://www.w3.org/2004/02/skos/core#definition> "A prescribed simulation protocol that models are run under, such as historical, piControl or ssp585. Corresponds to the ESGF experiment_id facet."@en .


###  https://climatepub4kg.github.io/ontology#ExperimentFamily
:ExperimentFamily rdf:type owl:Class ;
                  rdfs:comment "A grouping of experiments that share a common protocol or scientific purpose, such as the DECK, historical or ScenarioMIP families."@en ;
                  rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                  rdfs:label "ExperimentFamily" ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A grouping of experiments that share a common protocol or scientific purpose, such as the DECK, historical or ScenarioMIP families."@en .


###  https://climatepub4kg.github.io/ontology#Field
:Field rdf:type owl:Class ;
       rdfs:comment "The research field or discipline a publication belongs to, such as regional climate modelling or detection and attribution."@en ;
       rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
       rdfs:label "Field" ;
       <http://www.w3.org/2004/02/skos/core#definition> "The research field or discipline a publication belongs to, such as regional climate modelling or detection and attribution."@en .


###  https://climatepub4kg.github.io/ontology#Forcing
:Forcing rdf:type owl:Class ;
         rdfs:comment "An external forcing agent or forcing dataset prescribed by an experiment, such as greenhouse gas concentrations, aerosol emissions, land use or solar variability."@en ;
         rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
         rdfs:label "Forcing" ;
         <http://www.w3.org/2004/02/skos/core#definition> "An external forcing agent or forcing dataset prescribed by an experiment, such as greenhouse gas concentrations, aerosol emissions, land use or solar variability."@en .


###  https://climatepub4kg.github.io/ontology#Frequency
:Frequency rdf:type owl:Class ;
           rdfs:comment "The temporal sampling frequency at which model output is reported, such as mon, day, 6hr or fx (time-invariant). Corresponds to the ESGF frequency facet."@en ;
           rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
           rdfs:label "Frequency" ;
           <http://www.w3.org/2004/02/skos/core#definition> "The temporal sampling frequency at which model output is reported, such as mon, day, 6hr or fx (time-invariant). Corresponds to the ESGF frequency facet."@en .


###  https://climatepub4kg.github.io/ontology#GridLabel
:GridLabel rdf:type owl:Class ;
           rdfs:comment "The label identifying the grid a dataset is reported on, such as gn (the model's native grid) or gr (a regridded product). Corresponds to the ESGF grid_label facet."@en ;
           rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
           rdfs:label "GridLabel" ;
           <http://www.w3.org/2004/02/skos/core#definition> "The label identifying the grid a dataset is reported on, such as gn (the model's native grid) or gr (a regridded product). Corresponds to the ESGF grid_label facet."@en .


###  https://climatepub4kg.github.io/ontology#Innovation
:Innovation rdf:type owl:Class ;
            rdfs:comment "A novel contribution claimed by a publication or method, such as a new scheme, dataset or analysis approach."@en ;
            rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
            rdfs:label "Innovation" ;
            <http://www.w3.org/2004/02/skos/core#definition> "A novel contribution claimed by a publication or method, such as a new scheme, dataset or analysis approach."@en .


###  https://climatepub4kg.github.io/ontology#Institute
:Institute rdf:type owl:Class ;
           rdfs:comment "The institution that develops a climate model or carries out an experiment. Corresponds to the ESGF institution_id facet."@en ;
           rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
           rdfs:label "Institute" ;
           <http://www.w3.org/2004/02/skos/core#definition> "The institution that develops a climate model or carries out an experiment. Corresponds to the ESGF institution_id facet."@en .


###  https://climatepub4kg.github.io/ontology#Instrument
:Instrument rdf:type owl:Class ;
            rdfs:comment "A measuring instrument or sensor that observes geophysical variables, such as a satellite radiometer, radar or radiosonde. Aligned with the NASA GCMD instruments vocabulary."@en ;
            rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
            rdfs:label "Instrument" ;
            <http://www.w3.org/2004/02/skos/core#definition> "A measuring instrument or sensor that observes geophysical variables, such as a satellite radiometer, radar or radiosonde. Aligned with the NASA GCMD instruments vocabulary."@en .


###  https://climatepub4kg.github.io/ontology#Keyword
:Keyword rdf:type owl:Class ;
         rdfs:comment "A subject keyword or concept assigned to a publication, taken from the publication's bibliographic record."@en ;
         rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
         rdfs:label "Keyword" ;
         <http://www.w3.org/2004/02/skos/core#definition> "A subject keyword or concept assigned to a publication, taken from the publication's bibliographic record."@en .


###  https://climatepub4kg.github.io/ontology#MIPEra
:MIPEra rdf:type owl:Class ;
        rdfs:comment "A generation of the Model Intercomparison Project, such as CMIP5, CMIP6 or CMIP6Plus."@en ;
        rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
        rdfs:label "MIPEra" ;
        <http://www.w3.org/2004/02/skos/core#definition> "A generation of the Model Intercomparison Project, such as CMIP5, CMIP6 or CMIP6Plus."@en .


###  https://climatepub4kg.github.io/ontology#Member
:Member rdf:type owl:Class ;
        rdfs:comment "A variant label identifying one simulation of an experiment as a combination of realisation, initialisation, physics and forcing indices, such as r1i1p1f1. Corresponds to the ESGF member_id / variant_label facet."@en ;
        rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
        rdfs:label "Member" ;
        <http://www.w3.org/2004/02/skos/core#definition> "A variant label identifying one simulation of an experiment as a combination of realisation, initialisation, physics and forcing indices, such as r1i1p1f1. Corresponds to the ESGF member_id / variant_label facet."@en .


###  https://climatepub4kg.github.io/ontology#Method
:Method rdf:type owl:Class ;
        rdfs:comment "A method, technique, model configuration or analysis procedure that a publication applies."@en ;
        rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
        rdfs:label "Method" ;
        <http://www.w3.org/2004/02/skos/core#definition> "A method, technique, model configuration or analysis procedure that a publication applies."@en .


###  https://climatepub4kg.github.io/ontology#Metric
:Metric rdf:type owl:Class ;
        rdfs:comment "A characteristic quantity reported for a model, such as its equilibrium climate sensitivity, transient climate response or effective radiative forcing."@en ;
        rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
        rdfs:label "Metric" ;
        <http://www.w3.org/2004/02/skos/core#definition> "A characteristic quantity reported for a model, such as its equilibrium climate sensitivity, transient climate response or effective radiative forcing."@en .


###  https://climatepub4kg.github.io/ontology#Model
:Model rdf:type owl:Class ;
       rdfs:comment "Legacy class for a climate model. Superseded by Source and retained only so that older IRIs continue to resolve; new data should use Source."@en ;
       rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
       rdfs:label "Model" ;
       <http://www.w3.org/2004/02/skos/core#definition> "Legacy class for a climate model. Superseded by Source and retained only so that older IRIs continue to resolve; new data should use Source."@en .


###  https://climatepub4kg.github.io/ontology#NaturalHazardType
:NaturalHazardType rdf:type owl:Class ;
                   rdfs:comment "The category a natural hazard belongs to, such as flood, drought, heatwave, wildfire or tropical cyclone."@en ;
                   rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                   rdfs:label "NaturalHazardType" ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The category a natural hazard belongs to, such as flood, drought, heatwave, wildfire or tropical cyclone."@en .


###  https://climatepub4kg.github.io/ontology#Natural_Hazard
:Natural_Hazard rdf:type owl:Class ;
                rdfs:comment "A natural hazard studied in the corpus, such as a named flood, drought, wildfire or tropical cyclone."@en ;
                rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                rdfs:label "Natural_Hazard" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A natural hazard studied in the corpus, such as a named flood, drought, wildfire or tropical cyclone."@en .


###  https://climatepub4kg.github.io/ontology#No_Country_Region
:No_Country_Region rdf:type owl:Class ;
                   rdfs:comment "A named geographic region that is neither a country nor an administrative subdivision, such as a river basin, mountain range, sea, gulf or ocean sector, as identified in the GeoNames gazetteer."@en ;
                   rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                   rdfs:label "No_Country_Region" ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A named geographic region that is neither a country nor an administrative subdivision, such as a river basin, mountain range, sea, gulf or ocean sector, as identified in the GeoNames gazetteer."@en .


###  https://climatepub4kg.github.io/ontology#ObservationalDataset
:ObservationalDataset rdf:type owl:Class ;
                      rdfs:comment "An observational, reanalysis or reference dataset used to evaluate or drive a model, such as ERA5, GPCP or HadCRUT."@en ;
                      rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                      rdfs:label "ObservationalDataset" ;
                      <http://www.w3.org/2004/02/skos/core#definition> "An observational, reanalysis or reference dataset used to evaluate or drive a model, such as ERA5, GPCP or HadCRUT."@en .


###  https://climatepub4kg.github.io/ontology#Ocean_Circulation
:Ocean_Circulation rdf:type owl:Class ;
                   rdfs:comment "An ocean current or circulation feature, such as the Atlantic Meridional Overturning Circulation, the Gulf Stream or the Antarctic Circumpolar Current. Aligned with the NASA GCMD science keywords."@en ;
                   rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                   rdfs:label "Ocean_Circulation" ;
                   <http://www.w3.org/2004/02/skos/core#definition> "An ocean current or circulation feature, such as the Atlantic Meridional Overturning Circulation, the Gulf Stream or the Antarctic Circumpolar Current. Aligned with the NASA GCMD science keywords."@en .


###  https://climatepub4kg.github.io/ontology#Paper
:Paper rdf:type owl:Class ;
       rdfs:comment "A scientific publication about climate science, identified by its OpenAlex work identifier and, where available, its DOI. Papers are the provenance anchor for the extracted content in the graph."@en ;
       rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
       rdfs:label "Paper" ;
       <http://www.w3.org/2004/02/skos/core#definition> "A scientific publication about climate science, identified by its OpenAlex work identifier and, where available, its DOI. Papers are the provenance anchor for the extracted content in the graph."@en .


###  https://climatepub4kg.github.io/ontology#PhysicalFeature
:PhysicalFeature rdf:type owl:Class ;
                 rdfs:comment "A physical process or property represented in a model, such as interactive aerosols, dynamic vegetation, an interactive carbon cycle or a prognostic ice sheet."@en ;
                 rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                 rdfs:label "PhysicalFeature" ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A physical process or property represented in a model, such as interactive aerosols, dynamic vegetation, an interactive carbon cycle or a prognostic ice sheet."@en .


###  https://climatepub4kg.github.io/ontology#PhysicalScheme
:PhysicalScheme rdf:type owl:Class ;
                rdfs:comment "A parameterisation or numerical scheme implemented in a model, such as a convection, radiation, cloud microphysics or boundary-layer scheme."@en ;
                rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                rdfs:label "PhysicalScheme" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A parameterisation or numerical scheme implemented in a model, such as a convection, radiation, cloud microphysics or boundary-layer scheme."@en .


###  https://climatepub4kg.github.io/ontology#Platform
:Platform rdf:type owl:Class ;
          rdfs:comment "A platform that carries observing instruments, such as a satellite, aircraft, ship, buoy or ground station. Aligned with the NASA GCMD platforms vocabulary."@en ;
          rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
          rdfs:label "Platform" ;
          <http://www.w3.org/2004/02/skos/core#definition> "A platform that carries observing instruments, such as a satellite, aircraft, ship, buoy or ground station. Aligned with the NASA GCMD platforms vocabulary."@en .


###  https://climatepub4kg.github.io/ontology#Problem
:Problem rdf:type owl:Class ;
         rdfs:comment "A research problem, limitation or open question that a publication, method or task addresses."@en ;
         rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
         rdfs:label "Problem" ;
         <http://www.w3.org/2004/02/skos/core#definition> "A research problem, limitation or open question that a publication, method or task addresses."@en .


###  https://climatepub4kg.github.io/ontology#Project
:Project rdf:type owl:Class ;
         rdfs:comment "A research project or coordinated programme that models, experiments and datasets belong to, such as CMIP6, CORDEX or input4MIPs."@en ;
         rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
         rdfs:label "Project" ;
         <http://www.w3.org/2004/02/skos/core#definition> "A research project or coordinated programme that models, experiments and datasets belong to, such as CMIP6, CORDEX or input4MIPs."@en .


###  https://climatepub4kg.github.io/ontology#RCM
:RCM rdf:type owl:Class ;
     rdfs:comment "A regional climate model: a limited-area model run at higher resolution over a specific domain, driven at its boundaries by a global model or a reanalysis."@en ;
     rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
     rdfs:label "RCM" ;
     <http://www.w3.org/2004/02/skos/core#definition> "A regional climate model: a limited-area model run at higher resolution over a specific domain, driven at its boundaries by a global model or a reanalysis."@en .


###  https://climatepub4kg.github.io/ontology#Realm
:Realm rdf:type owl:Class ;
       rdfs:comment "A component of the Earth system that a model, model component, experiment or activity addresses, such as atmos, ocean, land, seaIce, landIce, aerosol or atmosChem."@en ;
       rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
       rdfs:label "Realm" ;
       <http://www.w3.org/2004/02/skos/core#definition> "A component of the Earth system that a model, model component, experiment or activity addresses, such as atmos, ocean, land, seaIce, landIce, aerosol or atmosChem."@en .


###  https://climatepub4kg.github.io/ontology#Resolution
:Resolution rdf:type owl:Class ;
            rdfs:comment "The nominal spatial resolution of a model, experiment or variable, expressed as a distance such as 100 km. Corresponds to the ESGF nominal_resolution facet."@en ;
            rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
            rdfs:label "Resolution" ;
            <http://www.w3.org/2004/02/skos/core#definition> "The nominal spatial resolution of a model, experiment or variable, expressed as a distance such as 100 km. Corresponds to the ESGF nominal_resolution facet."@en .


###  https://climatepub4kg.github.io/ontology#Result
:Result rdf:type owl:Class ;
        rdfs:comment "A reported finding or quantitative outcome of a publication, model or method."@en ;
        rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
        rdfs:label "Result" ;
        <http://www.w3.org/2004/02/skos/core#definition> "A reported finding or quantitative outcome of a publication, model or method."@en .


###  https://climatepub4kg.github.io/ontology#SimulationType
:SimulationType rdf:type owl:Class ;
                rdfs:comment "A characteristic style of simulation a model is run in, such as fully coupled, AMIP-style (prescribed sea surface temperatures), nudged or time-slice."@en ;
                rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                rdfs:label "SimulationType" ;
