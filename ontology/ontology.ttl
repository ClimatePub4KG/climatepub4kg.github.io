                           :Teleconnection ,
                           :Variable ,
                           :Weather_Event ;
                rdfs:comment "Relates a publication to any entity mentioned in its text. This is the general-purpose provenance bridge between the literature and the rest of the graph, and is asserted whenever entity linking matched a mention to a node."@en ;
                rdfs:isDefinedBy <https://climatepub4kg.github.io/ontology> ;
                rdfs:label "PAPER_MENTIONS" ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates a publication to any entity mentioned in its text. This is the general-purpose provenance bridge between the literature and the rest of the graph, and is asserted whenever entity linking matched a mention to a node."@en .


