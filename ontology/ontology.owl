    <!-- https://climatepub4kg.github.io/ontology#Activity -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Activity">
        <rdfs:comment xml:lang="en">A Model Intercomparison Project (MIP) activity within a MIP era, such as CMIP, ScenarioMIP or DAMIP, that defines and coordinates a related set of climate model experiments. Corresponds to the ESGF activity_id facet.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Activity</rdfs:label>
        <skos:definition xml:lang="en">A Model Intercomparison Project (MIP) activity within a MIP era, such as CMIP, ScenarioMIP or DAMIP, that defines and coordinates a related set of climate model experiments. Corresponds to the ESGF activity_id facet.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Author -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Author">
        <rdfs:comment xml:lang="en">A person credited as an author of a publication.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Author</rdfs:label>
        <skos:definition xml:lang="en">A person credited as an author of a publication.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#City -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#City">
        <rdfs:comment xml:lang="en">A populated place, such as a city, town or village, as identified in the GeoNames gazetteer.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>City</rdfs:label>
        <skos:definition xml:lang="en">A populated place, such as a city, town or village, as identified in the GeoNames gazetteer.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#ClimateZone -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#ClimateZone">
        <rdfs:comment xml:lang="en">A broad climate zone (tropical, arid, temperate, cold or polar) following the top level of the Koppen-Geiger climate classification.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>ClimateZone</rdfs:label>
        <skos:definition xml:lang="en">A broad climate zone (tropical, arid, temperate, cold or polar) following the top level of the Koppen-Geiger climate classification.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Continent -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Continent">
        <rdfs:comment xml:lang="en">A continent, as identified in the GeoNames gazetteer.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Continent</rdfs:label>
        <skos:definition xml:lang="en">A continent, as identified in the GeoNames gazetteer.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Country -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Country">
        <rdfs:comment xml:lang="en">A country or dependent territory, as identified in the GeoNames gazetteer, together with its ISO codes and country-level attributes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Country</rdfs:label>
        <skos:definition xml:lang="en">A country or dependent territory, as identified in the GeoNames gazetteer, together with its ISO codes and country-level attributes.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Country_Subdivision -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Country_Subdivision">
        <rdfs:comment xml:lang="en">A first-level administrative subdivision of a country, such as a state, province, region or canton, as identified in the GeoNames gazetteer.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Country_Subdivision</rdfs:label>
        <skos:definition xml:lang="en">A first-level administrative subdivision of a country, such as a state, province, region or canton, as identified in the GeoNames gazetteer.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Domain -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Domain">
        <rdfs:comment xml:lang="en">A named spatial domain over which a project or regional climate model is run, such as the CORDEX domains EUR-11 or AFR-44.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Domain</rdfs:label>
        <skos:definition xml:lang="en">A named spatial domain over which a project or regional climate model is run, such as the CORDEX domains EUR-11 or AFR-44.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Ensemble -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Ensemble">
        <rdfs:comment xml:lang="en">A set of simulations of the same experiment that differ only in their realisation, initialisation, physics or forcing settings, used to sample uncertainty.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Ensemble</rdfs:label>
        <skos:definition xml:lang="en">A set of simulations of the same experiment that differ only in their realisation, initialisation, physics or forcing settings, used to sample uncertainty.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#EvaluationMetric -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#EvaluationMetric">
        <rdfs:comment xml:lang="en">A measure used to evaluate a model, method, task or result, such as root-mean-square error, bias, correlation or skill score.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>EvaluationMetric</rdfs:label>
        <skos:definition xml:lang="en">A measure used to evaluate a model, method, task or result, such as root-mean-square error, bias, correlation or skill score.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Experiment -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Experiment">
        <rdfs:comment xml:lang="en">A prescribed simulation protocol that models are run under, such as historical, piControl or ssp585. Corresponds to the ESGF experiment_id facet.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Experiment</rdfs:label>
        <skos:definition xml:lang="en">A prescribed simulation protocol that models are run under, such as historical, piControl or ssp585. Corresponds to the ESGF experiment_id facet.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#ExperimentFamily -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#ExperimentFamily">
        <rdfs:comment xml:lang="en">A grouping of experiments that share a common protocol or scientific purpose, such as the DECK, historical or ScenarioMIP families.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>ExperimentFamily</rdfs:label>
        <skos:definition xml:lang="en">A grouping of experiments that share a common protocol or scientific purpose, such as the DECK, historical or ScenarioMIP families.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Field -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Field">
        <rdfs:comment xml:lang="en">The research field or discipline a publication belongs to, such as regional climate modelling or detection and attribution.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Field</rdfs:label>
        <skos:definition xml:lang="en">The research field or discipline a publication belongs to, such as regional climate modelling or detection and attribution.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Forcing -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Forcing">
        <rdfs:comment xml:lang="en">An external forcing agent or forcing dataset prescribed by an experiment, such as greenhouse gas concentrations, aerosol emissions, land use or solar variability.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Forcing</rdfs:label>
        <skos:definition xml:lang="en">An external forcing agent or forcing dataset prescribed by an experiment, such as greenhouse gas concentrations, aerosol emissions, land use or solar variability.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Frequency -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Frequency">
        <rdfs:comment xml:lang="en">The temporal sampling frequency at which model output is reported, such as mon, day, 6hr or fx (time-invariant). Corresponds to the ESGF frequency facet.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Frequency</rdfs:label>
        <skos:definition xml:lang="en">The temporal sampling frequency at which model output is reported, such as mon, day, 6hr or fx (time-invariant). Corresponds to the ESGF frequency facet.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#GridLabel -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#GridLabel">
        <rdfs:comment xml:lang="en">The label identifying the grid a dataset is reported on, such as gn (the model&apos;s native grid) or gr (a regridded product). Corresponds to the ESGF grid_label facet.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>GridLabel</rdfs:label>
        <skos:definition xml:lang="en">The label identifying the grid a dataset is reported on, such as gn (the model&apos;s native grid) or gr (a regridded product). Corresponds to the ESGF grid_label facet.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Innovation -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Innovation">
        <rdfs:comment xml:lang="en">A novel contribution claimed by a publication or method, such as a new scheme, dataset or analysis approach.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Innovation</rdfs:label>
        <skos:definition xml:lang="en">A novel contribution claimed by a publication or method, such as a new scheme, dataset or analysis approach.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Institute -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Institute">
        <rdfs:comment xml:lang="en">The institution that develops a climate model or carries out an experiment. Corresponds to the ESGF institution_id facet.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Institute</rdfs:label>
        <skos:definition xml:lang="en">The institution that develops a climate model or carries out an experiment. Corresponds to the ESGF institution_id facet.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Instrument -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Instrument">
        <rdfs:comment xml:lang="en">A measuring instrument or sensor that observes geophysical variables, such as a satellite radiometer, radar or radiosonde. Aligned with the NASA GCMD instruments vocabulary.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Instrument</rdfs:label>
        <skos:definition xml:lang="en">A measuring instrument or sensor that observes geophysical variables, such as a satellite radiometer, radar or radiosonde. Aligned with the NASA GCMD instruments vocabulary.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Keyword -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Keyword">
        <rdfs:comment xml:lang="en">A subject keyword or concept assigned to a publication, taken from the publication&apos;s bibliographic record.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Keyword</rdfs:label>
        <skos:definition xml:lang="en">A subject keyword or concept assigned to a publication, taken from the publication&apos;s bibliographic record.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#MIPEra -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#MIPEra">
        <rdfs:comment xml:lang="en">A generation of the Model Intercomparison Project, such as CMIP5, CMIP6 or CMIP6Plus.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>MIPEra</rdfs:label>
        <skos:definition xml:lang="en">A generation of the Model Intercomparison Project, such as CMIP5, CMIP6 or CMIP6Plus.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Member -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Member">
        <rdfs:comment xml:lang="en">A variant label identifying one simulation of an experiment as a combination of realisation, initialisation, physics and forcing indices, such as r1i1p1f1. Corresponds to the ESGF member_id / variant_label facet.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Member</rdfs:label>
        <skos:definition xml:lang="en">A variant label identifying one simulation of an experiment as a combination of realisation, initialisation, physics and forcing indices, such as r1i1p1f1. Corresponds to the ESGF member_id / variant_label facet.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Method -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Method">
        <rdfs:comment xml:lang="en">A method, technique, model configuration or analysis procedure that a publication applies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Method</rdfs:label>
        <skos:definition xml:lang="en">A method, technique, model configuration or analysis procedure that a publication applies.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Metric -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Metric">
        <rdfs:comment xml:lang="en">A characteristic quantity reported for a model, such as its equilibrium climate sensitivity, transient climate response or effective radiative forcing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Metric</rdfs:label>
        <skos:definition xml:lang="en">A characteristic quantity reported for a model, such as its equilibrium climate sensitivity, transient climate response or effective radiative forcing.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Model -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Model">
        <rdfs:comment xml:lang="en">Legacy class for a climate model. Superseded by Source and retained only so that older IRIs continue to resolve; new data should use Source.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Model</rdfs:label>
        <skos:definition xml:lang="en">Legacy class for a climate model. Superseded by Source and retained only so that older IRIs continue to resolve; new data should use Source.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#NaturalHazardType -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#NaturalHazardType">
        <rdfs:comment xml:lang="en">The category a natural hazard belongs to, such as flood, drought, heatwave, wildfire or tropical cyclone.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>NaturalHazardType</rdfs:label>
        <skos:definition xml:lang="en">The category a natural hazard belongs to, such as flood, drought, heatwave, wildfire or tropical cyclone.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Natural_Hazard -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Natural_Hazard">
        <rdfs:comment xml:lang="en">A natural hazard studied in the corpus, such as a named flood, drought, wildfire or tropical cyclone.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Natural_Hazard</rdfs:label>
        <skos:definition xml:lang="en">A natural hazard studied in the corpus, such as a named flood, drought, wildfire or tropical cyclone.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#No_Country_Region -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#No_Country_Region">
        <rdfs:comment xml:lang="en">A named geographic region that is neither a country nor an administrative subdivision, such as a river basin, mountain range, sea, gulf or ocean sector, as identified in the GeoNames gazetteer.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>No_Country_Region</rdfs:label>
        <skos:definition xml:lang="en">A named geographic region that is neither a country nor an administrative subdivision, such as a river basin, mountain range, sea, gulf or ocean sector, as identified in the GeoNames gazetteer.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#ObservationalDataset -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#ObservationalDataset">
        <rdfs:comment xml:lang="en">An observational, reanalysis or reference dataset used to evaluate or drive a model, such as ERA5, GPCP or HadCRUT.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>ObservationalDataset</rdfs:label>
        <skos:definition xml:lang="en">An observational, reanalysis or reference dataset used to evaluate or drive a model, such as ERA5, GPCP or HadCRUT.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Ocean_Circulation -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Ocean_Circulation">
        <rdfs:comment xml:lang="en">An ocean current or circulation feature, such as the Atlantic Meridional Overturning Circulation, the Gulf Stream or the Antarctic Circumpolar Current. Aligned with the NASA GCMD science keywords.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Ocean_Circulation</rdfs:label>
        <skos:definition xml:lang="en">An ocean current or circulation feature, such as the Atlantic Meridional Overturning Circulation, the Gulf Stream or the Antarctic Circumpolar Current. Aligned with the NASA GCMD science keywords.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Paper -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Paper">
        <rdfs:comment xml:lang="en">A scientific publication about climate science, identified by its OpenAlex work identifier and, where available, its DOI. Papers are the provenance anchor for the extracted content in the graph.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Paper</rdfs:label>
        <skos:definition xml:lang="en">A scientific publication about climate science, identified by its OpenAlex work identifier and, where available, its DOI. Papers are the provenance anchor for the extracted content in the graph.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#PhysicalFeature -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#PhysicalFeature">
        <rdfs:comment xml:lang="en">A physical process or property represented in a model, such as interactive aerosols, dynamic vegetation, an interactive carbon cycle or a prognostic ice sheet.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>PhysicalFeature</rdfs:label>
        <skos:definition xml:lang="en">A physical process or property represented in a model, such as interactive aerosols, dynamic vegetation, an interactive carbon cycle or a prognostic ice sheet.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#PhysicalScheme -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#PhysicalScheme">
        <rdfs:comment xml:lang="en">A parameterisation or numerical scheme implemented in a model, such as a convection, radiation, cloud microphysics or boundary-layer scheme.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>PhysicalScheme</rdfs:label>
        <skos:definition xml:lang="en">A parameterisation or numerical scheme implemented in a model, such as a convection, radiation, cloud microphysics or boundary-layer scheme.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Platform -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Platform">
        <rdfs:comment xml:lang="en">A platform that carries observing instruments, such as a satellite, aircraft, ship, buoy or ground station. Aligned with the NASA GCMD platforms vocabulary.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Platform</rdfs:label>
        <skos:definition xml:lang="en">A platform that carries observing instruments, such as a satellite, aircraft, ship, buoy or ground station. Aligned with the NASA GCMD platforms vocabulary.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Problem -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Problem">
        <rdfs:comment xml:lang="en">A research problem, limitation or open question that a publication, method or task addresses.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Problem</rdfs:label>
        <skos:definition xml:lang="en">A research problem, limitation or open question that a publication, method or task addresses.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Project -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Project">
        <rdfs:comment xml:lang="en">A research project or coordinated programme that models, experiments and datasets belong to, such as CMIP6, CORDEX or input4MIPs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Project</rdfs:label>
        <skos:definition xml:lang="en">A research project or coordinated programme that models, experiments and datasets belong to, such as CMIP6, CORDEX or input4MIPs.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#RCM -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#RCM">
        <rdfs:comment xml:lang="en">A regional climate model: a limited-area model run at higher resolution over a specific domain, driven at its boundaries by a global model or a reanalysis.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>RCM</rdfs:label>
        <skos:definition xml:lang="en">A regional climate model: a limited-area model run at higher resolution over a specific domain, driven at its boundaries by a global model or a reanalysis.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Realm -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Realm">
        <rdfs:comment xml:lang="en">A component of the Earth system that a model, model component, experiment or activity addresses, such as atmos, ocean, land, seaIce, landIce, aerosol or atmosChem.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Realm</rdfs:label>
        <skos:definition xml:lang="en">A component of the Earth system that a model, model component, experiment or activity addresses, such as atmos, ocean, land, seaIce, landIce, aerosol or atmosChem.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Resolution -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Resolution">
        <rdfs:comment xml:lang="en">The nominal spatial resolution of a model, experiment or variable, expressed as a distance such as 100 km. Corresponds to the ESGF nominal_resolution facet.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Resolution</rdfs:label>
        <skos:definition xml:lang="en">The nominal spatial resolution of a model, experiment or variable, expressed as a distance such as 100 km. Corresponds to the ESGF nominal_resolution facet.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Result -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Result">
        <rdfs:comment xml:lang="en">A reported finding or quantitative outcome of a publication, model or method.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Result</rdfs:label>
        <skos:definition xml:lang="en">A reported finding or quantitative outcome of a publication, model or method.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#SimulationType -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#SimulationType">
        <rdfs:comment xml:lang="en">A characteristic style of simulation a model is run in, such as fully coupled, AMIP-style (prescribed sea surface temperatures), nudged or time-slice.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>SimulationType</rdfs:label>
        <skos:definition xml:lang="en">A characteristic style of simulation a model is run in, such as fully coupled, AMIP-style (prescribed sea surface temperatures), nudged or time-slice.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Source -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Source">
        <rdfs:comment xml:lang="en">A climate or Earth system model: a named, versioned model configuration that produces simulation output. Corresponds to the ESGF source_id facet.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Source</rdfs:label>
        <skos:definition xml:lang="en">A climate or Earth system model: a named, versioned model configuration that produces simulation output. Corresponds to the ESGF source_id facet.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#SourceComponent -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#SourceComponent">
        <rdfs:comment xml:lang="en">A submodel of a climate model, such as its atmosphere, ocean, sea-ice, land-surface or aerosol component, usually together with the component&apos;s own version label.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>SourceComponent</rdfs:label>
        <skos:definition xml:lang="en">A submodel of a climate model, such as its atmosphere, ocean, sea-ice, land-surface or aerosol component, usually together with the component&apos;s own version label.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#SourceType -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#SourceType">
        <rdfs:comment xml:lang="en">The category of a climate model, such as AOGCM, AGCM, BGC or CHEM, describing which Earth system components the model couples. Corresponds to the ESGF source_type facet.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>SourceType</rdfs:label>
        <skos:definition xml:lang="en">The category of a climate model, such as AOGCM, AGCM, BGC or CHEM, describing which Earth system components the model couples. Corresponds to the ESGF source_type facet.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#SubExperiment -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#SubExperiment">
        <rdfs:comment xml:lang="en">A refinement of an experiment that fixes additional initialisation conditions, for example a particular start year of a decadal prediction. Corresponds to the ESGF sub_experiment_id facet.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>SubExperiment</rdfs:label>
        <skos:definition xml:lang="en">A refinement of an experiment that fixes additional initialisation conditions, for example a particular start year of a decadal prediction. Corresponds to the ESGF sub_experiment_id facet.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Task -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Task">
        <rdfs:comment xml:lang="en">A concrete research task that a publication or method carries out, such as bias correction, downscaling or extreme-event detection.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Task</rdfs:label>
        <skos:definition xml:lang="en">A concrete research task that a publication or method carries out, such as bias correction, downscaling or extreme-event detection.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Teleconnection -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Teleconnection">
        <rdfs:comment xml:lang="en">A large-scale mode of climate variability that links distant regions, such as ENSO, the North Atlantic Oscillation or the Pacific Decadal Oscillation. Aligned with the NASA GCMD science keywords.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Teleconnection</rdfs:label>
        <skos:definition xml:lang="en">A large-scale mode of climate variability that links distant regions, such as ENSO, the North Atlantic Oscillation or the Pacific Decadal Oscillation. Aligned with the NASA GCMD science keywords.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Variable -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Variable">
        <rdfs:comment xml:lang="en">A geophysical output quantity reported by a model, such as tas (near-surface air temperature) or pr (precipitation), described by its CF standard name, long name and units. Corresponds to the ESGF variable_id facet.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Variable</rdfs:label>
        <skos:definition xml:lang="en">A geophysical output quantity reported by a model, such as tas (near-surface air temperature) or pr (precipitation), described by its CF standard name, long name and units. Corresponds to the ESGF variable_id facet.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Venue -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Venue">
        <rdfs:comment xml:lang="en">The journal, conference, book series or repository in which a publication appeared.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Venue</rdfs:label>
        <skos:definition xml:lang="en">The journal, conference, book series or repository in which a publication appeared.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Water_Bodies -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Water_Bodies">
        <rdfs:comment xml:lang="en">A named body of water, such as a sea, lake or gulf. Retained for backwards compatibility; water bodies are currently represented as No_Country_Region instances.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Water_Bodies</rdfs:label>
        <skos:definition xml:lang="en">A named body of water, such as a sea, lake or gulf. Retained for backwards compatibility; water bodies are currently represented as No_Country_Region instances.</skos:definition>
    </owl:Class>
    


    <!-- https://climatepub4kg.github.io/ontology#Weather_Event -->


    <owl:Class rdf:about="https://climatepub4kg.github.io/ontology#Weather_Event">
        <rdfs:comment xml:lang="en">A weather or climate event discussed in the literature, such as a particular heatwave, storm, cold spell or extreme rainfall episode.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>Weather_Event</rdfs:label>
        <skos:definition xml:lang="en">A weather or climate event discussed in the literature, such as a particular heatwave, storm, cold spell or extreme rainfall episode.</skos:definition>
    </owl:Class>
</rdf:RDF>



