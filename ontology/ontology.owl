        <rdfs:range rdf:resource="https://climatepub4kg.github.io/ontology#Member"/>
        <rdfs:comment xml:lang="en">Relates a climate model to a variant label (member) under which its output was produced.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>ASSOCIATED_WITH_MEMBER</rdfs:label>
        <skos:definition xml:lang="en">Relates a climate model to a variant label (member) under which its output was produced.</skos:definition>
    </owl:ObjectProperty>
    


