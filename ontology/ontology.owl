    <!-- https://climatepub4kg.github.io/ontology#APPLIES_TO_REALM -->


    <owl:ObjectProperty rdf:about="https://climatepub4kg.github.io/ontology#APPLIES_TO_REALM">
        <rdfs:domain rdf:resource="https://climatepub4kg.github.io/ontology#Experiment"/>
        <rdfs:domain rdf:resource="https://climatepub4kg.github.io/ontology#Source"/>
        <rdfs:domain rdf:resource="https://climatepub4kg.github.io/ontology#SourceComponent"/>
        <rdfs:range rdf:resource="https://climatepub4kg.github.io/ontology#Realm"/>
        <rdfs:comment xml:lang="en">Relates a climate model, model component or experiment to an Earth system realm it addresses.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://climatepub4kg.github.io/ontology"/>
        <rdfs:label>APPLIES_TO_REALM</rdfs:label>
        <skos:definition xml:lang="en">Relates a climate model, model component or experiment to an Earth system realm it addresses.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://climatepub4kg.github.io/ontology#ASSOCIATED_WITH_MEMBER -->


    <owl:ObjectProperty rdf:about="https://climatepub4kg.github.io/ontology#ASSOCIATED_WITH_MEMBER">
